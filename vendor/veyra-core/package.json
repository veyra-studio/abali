{
  "name": "@veyra/core",
  "version": "0.1.0",
  "description": "Veyra \u2014 a creative web experience engine: frame loop, motion, scroll scenes, script-aware typography and adaptive rendering for ambitious websites.",
  "type": "module",
  "license": "MIT",
  "author": "Veyra Studio",
  "homepage": "https://veyra-studio.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veyra-studio/veyra-core.git"
  },
  "keywords": [
    "creative-coding",
    "animation",
    "scroll",
    "webgl",
    "three",
    "rtl",
    "persian",
    "motion"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "css",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js"
    },
    "./css": "./css/veyra.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples": "vite --config examples/vite.config.ts",
    "examples:build": "vite build --config examples/vite.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "release:pack": "npm run check && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/estedad": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.2",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
